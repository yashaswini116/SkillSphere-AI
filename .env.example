# SkillSphere AI — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to Git.

# ─── Groq AI (Ultra-fast LLM inference for AI Mentor chatbot & features) ─────
# Server-side only — NOT exposed in the browser bundle.
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_yourGroqApiKeyHere

# ─── Gemini AI (Alternative provider for AI Mentor chat & features) ──────────
# Server-side only — NOT exposed in the browser bundle.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Legacy / other AI features (optional — used by skill-gap, resume analyzer, etc.)
# This key IS sent to the browser, so keep it limited to non-sensitive AI calls.
NEXT_PUBLIC_GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ─── Firebase Configuration (REQUIRED for live auth & Firestore) ─────────────
# All NEXT_PUBLIC_ keys are safe to expose (they are public Firebase config).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKey
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
